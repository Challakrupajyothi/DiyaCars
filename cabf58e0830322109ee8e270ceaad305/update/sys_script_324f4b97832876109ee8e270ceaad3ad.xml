        <script><![CDATA[(function executeRule(current, previous) {
    if (current.isValidField('subscription') && current.subscription.changes()) {
        var consumerUserGR = new GlideRecord("csm_consumer_user");
        consumerUserGR.addQuery("user_name", current.user_id);
        consumerUserGR.query();
        if (consumerUserGR.next()) {
            var consumerGR = new GlideRecord("csm_consumer");
            consumerGR.addQuery("name", consumerUserGR.name);
            consumerGR.query();
            if (consumerGR.next()) {
                var ga=new global.EntitlementUtilsGlobal();
				ga.deleteEntitlements(consumerGR.sys_id);
            }
        }
		current.update();
		
    }
})(current, previous);
]]></script>
