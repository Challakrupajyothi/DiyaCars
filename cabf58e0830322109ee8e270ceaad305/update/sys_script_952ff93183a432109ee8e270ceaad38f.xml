        <script><![CDATA[(function executeRule(current, previous /*null when async*/) {
    // Find the sys_id of the "Customer" role
    var roleGr = new GlideRecord('sys_user_role');
    roleGr.addQuery('name', 'Customer');
    roleGr.query();
    if (roleGr.next()) {
        // Create a new sys_user_has_role record
        var userHasRoleGr = new GlideRecord('sys_user_has_role');
        userHasRoleGr.initialize();
        userHasRoleGr.user = current.getValue('user_name'); // assuming 'user' is a reference field on the current record
        userHasRoleGr.role = roleGr.getUniqueValue();
        userHasRoleGr.insert();
        gs.addInfoMessage('Customer role assigned to user: ' + current.getDisplayValue('user_name'));
    } else {
        gs.addErrorMessage('Customer role not found.');
    }
})(current, previous);
]]></script>
