        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
    if (isLoading || newValue === '') return;
    var consumerID=g_form.getValue("consumer");
    var ga1 = new GlideAjax("ServiceCarWashEntitlement");
    ga1.addParam('sysparm_name', 'servicecreateEntitlement'); 
    ga1.addParam('sysparm_plan', newValue);
    ga1.addParam('sysparm_consumer', consumerID);

    ga1.getXMLAnswer(function(response) {
        if (response == "created") {
            g_form.addInfoMessage("✅ Entitlement created successfully for " + newValue + " plan.");
        } else {
            g_form.addErrorMessage("⚠️ Failed to create entitlement: " + response);
        }
    });
}
