        <messages/>
        <name>subscription</name>
        <order/>
        <script><![CDATA[function onChange(control, oldValue, newValue, isLoading, isTemplate) {
	var consumerID=g_form.getValue("user_id");
	g_form.addErrorMessage(consumerID);
   if (isLoading || newValue === '') return;
   if (newValue == "Advance" || newValue == "Premium") {
	alert("hello");
      var ga = new GlideAjax("CreateCarWashEntitlement");
      ga.addParam('sysparm_name', 'createEntitlement'); 
      ga.addParam('sysparm_plan', newValue);
      ga.addParam('sysparm_consumer', consumerID);

      ga.getXMLAnswer(function(response) {
		//g_form.addErrorMessage(response);
         if (response == "created") {
            g_form.addInfoMessage("✅ Entitlement created for " + newValue + " plan.");
         }else {
            g_form.addErrorMessage("⚠️ Failed to create entitlement: " + response);
         }
      });
   }
}
]]></script>
